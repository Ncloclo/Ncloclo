{
  // Terminal ▸ Exécuter la tâche…
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Installer les dépendances",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "Télécharger les données de recherche",
      "type": "shell",
      "command": "python trend_strategy.py download --data data",
      "problemMatcher": []
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "python -m pytest tests -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "TrendGuard — paper (prix réels)",
      "type": "shell",
      "command": "python trendguard_bot.py run",
      "options": { "env": { "RUN_MODE": "paper" } },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "TrendGuard — statut",
      "type": "shell",
      "command": "python trendguard_bot.py status",
      "options": { "env": { "RUN_MODE": "paper" } },
      "problemMatcher": []
    },
    {
      "label": "Panneau de contrôle (navigateur)",
      "type": "shell",
      "command": "python trendguard_bot.py panel",
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Autonomie — superviseur (bot relancé seul en cas de plantage)",
      "type": "shell",
      "command": "python trendguard_bot.py supervise",
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Autonomie — démarrer avec l'ordinateur",
      "type": "shell",
      "command": "python trendguard_bot.py autostart on",
      "problemMatcher": []
    },
    {
      "label": "Autonomie — ne plus démarrer avec l'ordinateur",
      "type": "shell",
      "command": "python trendguard_bot.py autostart off",
      "problemMatcher": []
    },
    {
      "label": "Autonomie — arrêter l'automatisation",
      "type": "shell",
      "command": "python trendguard_bot.py stop",
      "problemMatcher": []
    },
    {
      "label": "Panneau — définir le mot de passe (saisie masquée)",
      "type": "shell",
      "command": "python trendguard_bot.py set-panel-password",
      "presentation": { "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Panneau — accès téléphone (port 8766)",
      "type": "shell",
      "command": "python trendguard_bot.py panel --host 0.0.0.0 --port 8766 --no-open",
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Alertes — configurer e-mail et WhatsApp (saisie masquée)",
      "type": "shell",
      "command": "python alerts.py configurer",
      "presentation": { "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Alertes — envoyer un message de test",
      "type": "shell",
      "command": "python alerts.py tester",
      "problemMatcher": []
    },
    {
      "label": "Veille IA — enregistrer une clé d'IA (saisie masquée)",
      "type": "shell",
      "command": "python market_watch.py set-key ${input:veilleIA}",
      "presentation": { "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Veille IA — tester les IA configurées",
      "type": "shell",
      "command": "python market_watch.py check",
      "problemMatcher": []
    },
    {
      "label": "Veille IA — rapport du jour",
      "type": "shell",
      "command": "python market_watch.py",
      "problemMatcher": []
    },
    {
      "label": "Binance — enregistrer les clés API (vérifiées, saisie masquée)",
      "type": "shell",
      "command": "python trendguard_bot.py set-keys",
      "presentation": { "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Binance — enregistrer la clé secrète (saisie masquée)",
      "type": "shell",
      "command": "python trendguard_bot.py set-secret",
      "presentation": { "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Docker — démarrer le bot",
      "type": "shell",
      "command": "docker compose up -d --build && docker compose logs -f",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker — journal du bot en direct",
      "type": "shell",
      "command": "docker compose logs -f --tail 50",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker — statut du portefeuille",
      "type": "shell",
      "command": "docker compose exec trendguard python trendguard_bot.py status",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "veilleIA",
      "type": "pickString",
      "description": "IA dont vous enregistrez la clé",
      "options": ["claude", "openai", "gemini", "deepseek", "mistral", "kimi", "perplexity", "grok"]
    }
  ]
}
