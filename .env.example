# Copier ce fichier en .env (jamais commité) puis l'adapter.
# Utilisé par le bot en local (VS Code, terminal) et par docker compose.

# ── Mode ────────────────────────────────────────────────────────────
RUN_MODE=paper

# ── TrendGuard (valeurs validées par la recherche) ──────────────────
# Risque par trade : 0.01 = 1 % du capital (0.005 = plus stable)
TG_RISK_PCT=0.01
TG_MAX_POSITIONS=8
TG_MAX_TOTAL_RISK=0.06
TG_KILL_DRAWDOWN=0.40
TG_PAPER_CAPITAL=10000
# Compte réel : capital maximum confié au bot, en USDT (0 = tout le compte).
# Recommandé pour débuter : une petite somme, ex. 500.
TG_MAX_CAPITAL=0
# Profil prudent (optionnel) : risque ÷ 2 au-delà de 10 % de baisse depuis
# le pic (docs/ADAPTATION.md). Vide = désactivé.
TG_DD_THROTTLE=
# Auto-diagnostic tous les N jours pendant que le bot tourne (0 = off).
TG_AUTO_DIAGNOSE_DAYS=7
# Autonomie : l'ordinateur ne se met pas en veille tout seul pendant que le
# bot tourne (false = veille autorisée).
TG_KEEP_AWAKE=true
# Ruse : achat différé si le carnet d'ordres est anormal (écart achat/vente
# au-delà de 0,5 %, carnet vide ou trop mince), nouvel essai toutes les 5 min
# pendant 6 h.
TG_MAX_SPREAD=0.005
TG_ENTRY_RETRY_HOURS=6
# Classement quotidien des cryptos par bénéfice de la stratégie (page Cryptos
# du panneau, auto-sélection des 10 plus rentables).
TG_CLASSEMENT=true

# ── Live (testnet d'abord !) ────────────────────────────────────────
# BINANCE_TESTNET=true
# ENABLE_LIVE_TRADING=true
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_RISK
# RUN_MODE=live
# Clé API SANS droit de retrait :
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# ── Veille de marché (market_watch.py) ──────────────────────────────
# Annonces officielles Binance lues chaque jour : une crypto dont Binance
# annonce le retrait n'est plus achetée. Rapport quotidien des IA : conseil
# seulement, aucune IA ne passe d'ordre.
TG_VEILLE=true
TG_VEILLE_IA=true
# Clés des IA (optionnelles, payantes). Saisie masquée conseillée :
#   python market_watch.py set-key claude     (puis : python market_watch.py check)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# MOONSHOT_API_KEY=      (Kimi)
# PERPLEXITY_API_KEY=    (recherche web en direct)
# XAI_API_KEY=           (Grok)
# Modèle d'une IA, si le modèle par défaut n'est plus proposé :
# VEILLE_MODEL_GROK=grok-4

# ── Notifications (optionnel) ───────────────────────────────────────
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# E-mail et WhatsApp : saisie guidée avec « python alerts.py configurer ».
# ALERT_LEVEL=critical        (critical = alertes critiques ; all = tout)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=              (Gmail : mot de passe d'application)
# ALERT_EMAIL_TO=
# WHATSAPP_PROVIDER=callmebot (ou twilio)
# WHATSAPP_PHONE=+2250700000000
# CALLMEBOT_APIKEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# ── Panneau de contrôle (python trendguard_bot.py panel) ─────────────
# PANEL_PORT=8765
# Accès depuis un téléphone sur le même Wi-Fi : PANEL_HOST=0.0.0.0 et un
# mot de passe (obligatoire dans ce cas).
# PANEL_HOST=127.0.0.1
# Mot de passe : python trendguard_bot.py set-panel-password (saisie masquée).
# PANEL_PASSWORD=
# Assistant du panneau : réponses rédigées par l'IA de la veille si une clé
# existe (Claude de préférence) ; false = réponses intégrées seulement.
# PANEL_ASSISTANT_IA=true
# PANEL_ASSISTANT_MODEL=claude-sonnet-5
